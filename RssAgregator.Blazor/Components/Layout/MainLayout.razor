@inherits LayoutComponentBase
@* LayoutComponentBase: esta plantilla envuelve TODAS las páginas;
   el contenido de cada una se renderiza donde está @Body. *@

@* ===== HEADER ===== *@
<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="">
            <img src="images/logo.svg" alt="Logo de RssAgregator" class="brand-logo" />
            <span class="brand-name">Rss<span class="brand-accent">Agregator</span></span>
        </a>
        <NavMenu /> @* rutilizacion del componente de menú *@
    </div>
</header>

@* ===== CONTENIDO ===== *@
<main class="site-main">
    @Body
</main>

@* ===== FOOTER  ===== *@
<footer class="site-footer">
    <div class="footer-inner">
        <div><strong>RssAgregator</strong> — Todas tus noticias en un solo lugar</div>
    </div>
</footer>

@* UI de errores de Blazor  *@
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>